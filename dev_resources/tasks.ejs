<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tasks — dev</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
  <main class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold">Task board <span class="text-sm font-normal text-slate-400">(internal)</span></h1>

    <% if (!dbReady) { %>
      <p class="mt-4 rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800">
        MongoDB is not connected — set <code>MONGO_URI</code> in <code>.env</code> and make sure Mongo is running. Nothing will persist until then.
      </p>
    <% } %>

    <form method="POST" action="/dev-resources/tasks" class="mt-6 grid gap-2 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_auto_auto]">
      <input name="title" required placeholder="New task title" class="rounded border border-slate-300 px-3 py-2">
      <select name="status" class="rounded border border-slate-300 px-2 py-2">
        <% statuses.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
      </select>
      <button class="rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white">Add</button>
      <textarea name="description" rows="2" placeholder="Description (optional)" class="rounded border border-slate-300 px-3 py-2 sm:col-span-3"></textarea>
    </form>

    <% statuses.forEach(status => { const list = tasks.filter(t => t.status === status); %>
      <section class="mt-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= status %> (<%= list.length %>)</h2>
        <ul class="mt-2 space-y-2">
          <% list.forEach(task => { %>
            <li class="rounded-lg border border-slate-200 bg-white p-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-medium <%= task.status === 'done' ? 'line-through text-slate-400' : '' %>"><%= task.title %></p>
                  <% if (task.description) { %><p class="mt-1 whitespace-pre-line text-sm text-slate-600"><%= task.description %></p><% } %>
                  <p class="mt-1 text-xs text-slate-400">Updated <%= task.updatedAt.toISOString().slice(0, 16).replace('T', ' ') %></p>
                </div>
                <form method="POST" action="/dev-resources/tasks/<%= task._id %>/delete" onsubmit="return confirm('Delete this task?')">
                  <button class="text-xs text-red-600 hover:underline">Delete</button>
                </form>
              </div>
              <details class="mt-2">
                <summary class="cursor-pointer text-xs text-slate-500">Edit</summary>
                <form method="POST" action="/dev-resources/tasks/<%= task._id %>" class="mt-2 grid gap-2">
                  <input name="title" required value="<%= task.title %>" class="rounded border border-slate-300 px-3 py-1.5">
                  <textarea name="description" rows="2" class="rounded border border-slate-300 px-3 py-1.5"><%= task.description %></textarea>
                  <div class="flex gap-2">
                    <select name="status" class="rounded border border-slate-300 px-2 py-1.5">
                      <% statuses.forEach(s => { %><option value="<%= s %>" <%= s === task.status ? 'selected' : '' %>><%= s %></option><% }) %>
                    </select>
                    <button class="rounded bg-slate-900 px-3 py-1.5 text-sm text-white">Save</button>
                  </div>
                </form>
              </details>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>
  </main>
</body>
</html>

<%- include('../partials/head') %>
<div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2">
  <form class="rounded-md border border-zinc-200 bg-white p-6" onsubmit="return false">
    <h2 class="text-xl font-semibold">Log in</h2>
    <label class="mt-4 block text-sm">Email<input type="email" name="email" class="mt-1 w-full rounded border border-zinc-300 px-3 py-2"></label>
    <label class="mt-3 block text-sm">Password<input type="password" name="password" class="mt-1 w-full rounded border border-zinc-300 px-3 py-2"></label>
    <button class="mt-4 w-full rounded-md bg-zinc-900 py-2 text-sm font-medium text-white">Log in</button>
  </form>
  <form class="rounded-md border border-zinc-200 bg-white p-6" onsubmit="return false">
    <h2 class="text-xl font-semibold">Sign up</h2>
    <label class="mt-4 block text-sm">Name<input type="text" name="name" class="mt-1 w-full rounded border border-zinc-300 px-3 py-2"></label>
    <label class="mt-3 block text-sm">Email<input type="email" name="email" class="mt-1 w-full rounded border border-zinc-300 px-3 py-2"></label>
    <label class="mt-3 block text-sm">Password<input type="password" name="password" class="mt-1 w-full rounded border border-zinc-300 px-3 py-2"></label>
    <button class="mt-4 w-full rounded-md border border-zinc-900 py-2 text-sm font-medium">Create account</button>
  </form>
</div>
<p class="mt-4 text-center text-xs text-zinc-400">Placeholder — auth not wired up yet.</p>
<%- include('../partials/foot') %>
